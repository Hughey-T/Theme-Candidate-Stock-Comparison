{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "comparison-contract-v2.schema.json",
  "title": "Theme comparison contract 2.0",
  "$defs": {
    "horizon": {"type":"object","additionalProperties":false,"required":["horizon_id","minimum_months","maximum_months","benchmark","required_return"],"properties":{"horizon_id":{"type":"string","minLength":1},"minimum_months":{"type":"integer","minimum":1},"maximum_months":{"type":"integer","minimum":1},"benchmark":{"type":"string","minLength":1},"required_return":{"type":"number"}}},
    "information": {"type":"object","additionalProperties":false,"required":["information_id","classification","candidate_id","statement","source","as_of","method"],"properties":{"information_id":{"type":"string","minLength":1},"classification":{"enum":["FACTS","COMPANY_CLAIMS","EXTERNAL_ESTIMATES","AI_ASSUMPTIONS","JUDGMENTS","UNRESOLVED"]},"candidate_id":{"type":["string","null"]},"statement":{"type":"string","minLength":1},"source":{"type":["string","null"]},"as_of":{"type":"string","format":"date-time"},"method":{"type":["string","null"]}}},
    "judgment": {"type":"object","additionalProperties":false,"required":["statement","evidence_refs","contrary_evidence_refs","dependency_roots","confidence","uncertainty","invalidation_condition"],"properties":{"statement":{"type":"string"},"evidence_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},"contrary_evidence_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},"dependency_roots":{"type":"array","items":{"type":"string"},"uniqueItems":true},"confidence":{"enum":["low","medium","high"]},"uncertainty":{"type":"string"},"invalidation_condition":{"type":"string"}}},
    "ranking": {"type":"object","additionalProperties":false,"required":["ranking_kind","horizon_id","rows","provenance"],"properties":{"ranking_kind":{"enum":["evidence_only_mechanical","scenario_derived","independent_ai","integrated"]},"horizon_id":{"type":"string"},"rows":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["candidate_id","rank"],"properties":{"candidate_id":{"type":"string"},"rank":{"type":"integer","minimum":1}}}},"provenance":{"type":"array","items":{"type":"string"}}}},
    "candidateSetTransition": {"type":"object","additionalProperties":false,"required":["set_kind","candidate_set_id","candidate_ids","excluded"],"properties":{"set_kind":{"enum":["initial_candidate_set","eligible_candidate_set","deep_comparison_set","final_selection_set"]},"candidate_set_id":{"type":"string"},"candidate_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},"excluded":{"type":"array","items":{"type":"object"}}}},
    "pairwise": {"type":"object","additionalProperties":false,"required":["candidate_a","candidate_b","why_a_beats_b","why_b_beats_a","decisive_variable","reversal_condition","horizon_reversal","scenario_reversal","non_comparable_dimensions","evidence_advantage","uncertainty_advantage","valuation_advantage","permanent_loss_difference"],"properties":{"candidate_a":{"type":"string"},"candidate_b":{"type":"string"},"why_a_beats_b":{"type":"string"},"why_b_beats_a":{"type":"string"},"decisive_variable":{"type":"string"},"reversal_condition":{"type":"string"},"horizon_reversal":{"type":"string"},"scenario_reversal":{"type":"string"},"non_comparable_dimensions":{"type":"array","items":{"type":"string"}},"evidence_advantage":{"type":"string"},"uncertainty_advantage":{"type":"string"},"valuation_advantage":{"type":"string"},"permanent_loss_difference":{"type":"string"}}},
    "sensitivity": {"type":"object","additionalProperties":false,"required":["candidate_id","base_rank","robust_rank_min","robust_rank_max","rank_reversal_thresholds","fragile_assumptions","dominant_assumptions","scenario_dependence","valuation_dependence","evidence_dependence"],"properties":{"candidate_id":{"type":"string"},"base_rank":{"type":"integer"},"robust_rank_min":{"type":"integer"},"robust_rank_max":{"type":"integer"},"rank_reversal_thresholds":{"type":"array","items":{"type":"string"}},"fragile_assumptions":{"type":"array","items":{"type":"string"}},"dominant_assumptions":{"type":"array","items":{"type":"string"}},"scenario_dependence":{"type":"string"},"valuation_dependence":{"type":"string"},"evidence_dependence":{"type":"string"}}}
  },
  "type":"object","additionalProperties":false,"required":["generation_id","phase","information","payload"],"properties":{"generation_id":{"type":"string"},"phase":{"type":"integer","minimum":1,"maximum":12},"information":{"type":"array","items":{"$ref":"#/$defs/information"}},"payload":{"type":"object"}}
}
