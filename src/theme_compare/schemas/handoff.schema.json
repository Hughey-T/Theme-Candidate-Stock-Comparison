{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "handoff_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "generation_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_set_id": {
      "type": "string",
      "minLength": 1
    },
    "theme": {
      "type": "string",
      "minLength": 1
    },
    "comparison_as_of": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-]\\d\\d:\\d\\d)$"
    },
    "source_cutoff_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-]\\d\\d:\\d\\d)$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-]\\d\\d:\\d\\d)$"
    },
    "status": {
      "enum": [
        "active",
        "superseded",
        "invalidated"
      ]
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "invalidated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "invalidation_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "investment_horizon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tactical": {
          "const": "6-12 months"
        },
        "structural": {
          "const": "2-3 years"
        }
      },
      "required": [
        "tactical",
        "structural"
      ]
    },
    "primary_candidate": {
      "type": [
        "string",
        "null"
      ]
    },
    "secondary_candidate": {
      "type": [
        "string",
        "null"
      ]
    },
    "conditional_candidates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "watch_candidates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "excluded_candidates": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "overall_decision": {
      "enum": [
        "SELECTION",
        "NO_SELECTION"
      ]
    },
    "ranking_by_horizon": {
      "type": "object",
      "additionalProperties": true
    },
    "common_scenarios": {
      "type": "object",
      "additionalProperties": true
    },
    "company_scenario_results": {
      "type": "object",
      "additionalProperties": true
    },
    "key_assumptions": {
      "type": "array"
    },
    "shared_theme_risks": {
      "type": "array"
    },
    "company_specific_risks": {
      "type": "object",
      "additionalProperties": true
    },
    "catalysts": {
      "type": "object",
      "additionalProperties": true
    },
    "valuation_ranges": {
      "type": "object",
      "additionalProperties": true
    },
    "thesis_invalidation_conditions": {
      "type": "object",
      "additionalProperties": true
    },
    "confidence": {
      "type": "object",
      "additionalProperties": true
    },
    "evidence_manifest": {
      "type": "array"
    },
    "recommended_next_action": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "handoff_id",
    "session_id",
    "generation_id",
    "candidate_set_id",
    "theme",
    "comparison_as_of",
    "source_cutoff_at",
    "created_at",
    "status",
    "supersedes",
    "superseded_by",
    "invalidated_at",
    "invalidation_reason",
    "investment_horizon",
    "primary_candidate",
    "secondary_candidate",
    "conditional_candidates",
    "watch_candidates",
    "excluded_candidates",
    "overall_decision",
    "ranking_by_horizon",
    "common_scenarios",
    "company_scenario_results",
    "key_assumptions",
    "shared_theme_risks",
    "company_specific_risks",
    "catalysts",
    "valuation_ranges",
    "thesis_invalidation_conditions",
    "confidence",
    "evidence_manifest",
    "recommended_next_action"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
