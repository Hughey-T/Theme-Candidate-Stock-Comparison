{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "generation_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_set_id": {
      "type": "string",
      "minLength": 1
    },
    "source_cutoff_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-]\\d\\d:\\d\\d)$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-]\\d\\d:\\d\\d)$"
    },
    "inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "raw_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 48000
          },
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "part_count": {
            "type": "integer",
            "minimum": 1
          },
          "generation_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "raw_sha256",
          "size",
          "sequence",
          "part_count",
          "generation_id"
        ]
      }
    },
    "canonical_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verification_status": {
      "enum": [
        "not_generated",
        "generated_not_persisted",
        "persisted_pending_verification",
        "integrity_verified",
        "failed_terminal",
        "superseded"
      ]
    },
    "failure_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "failed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "failed_stage": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "generation_id",
    "candidate_set_id",
    "source_cutoff_at",
    "created_at",
    "inventory",
    "canonical_sha256",
    "verification_status"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
