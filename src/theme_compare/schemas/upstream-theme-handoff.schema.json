{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "theme": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "comparison_as_of": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-]\\d\\d:\\d\\d)$"
    },
    "source_cutoff_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-]\\d\\d:\\d\\d)$"
    },
    "candidate_inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "issuer_id": {
            "type": "string",
            "minLength": 1
          },
          "issuer_name": {
            "type": "string",
            "minLength": 1
          },
          "ticker": {
            "type": "string",
            "minLength": 1
          },
          "exchange": {
            "type": "string",
            "minLength": 1
          },
          "share_class": {
            "type": "string",
            "minLength": 1
          },
          "is_adr": {
            "type": "boolean"
          },
          "underlying_security_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "former_tickers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "corporate_action_lineage": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "listing_country": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "candidate_id",
          "issuer_id",
          "issuer_name",
          "ticker",
          "exchange",
          "share_class",
          "is_adr",
          "underlying_security_id",
          "former_tickers",
          "corporate_action_lineage",
          "listing_country"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      }
    },
    "source_generation_id": {
      "type": "string",
      "minLength": 1
    },
    "source_session_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "theme",
    "hypothesis",
    "comparison_as_of",
    "source_cutoff_at",
    "candidate_inputs",
    "source_generation_id",
    "source_session_id",
    "evidence_refs"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
